# Aether secrets — copy to .env (gitignored). Structure config lives in config.yaml.
#
# Optional for everything below the core: most app keys don't need this file at
# all — send /apps in chat, follow the link it gives, and paste the key right
# there. Pastes are consumed before the agent sees them (no LLM, no memory, no
# trace) and land in the same encrypted store as everything else; they also
# take precedence over this file, since a paste is the more recent act.

# --- Core (required) ---
# Neon connection string (free tier: https://neon.tech)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# base64 of 32 random bytes. Generate:
#   python -c "from aether.memory.crypto import generate_key_b64; print(generate_key_b64())"
AETHER_ENCRYPTION_KEY=
# Token guarding the API, WebSocket chat, and companion uploads
AETHER_TOKEN=change-me
PORT=8000

# --- LLM providers (set the one matching llm.provider in config.yaml) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Messaging (optional; also enable in config.yaml) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Dev convenience ---
# 1 = allow boot with an ephemeral encryption key (encrypted data won't survive restarts)
AETHER_DEV_EPHEMERAL_KEY=0
